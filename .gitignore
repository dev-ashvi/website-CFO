# Root ignores for local/dev stability — do not index or commit runtime/generated data.

# Dependencies & build
node_modules/
dist/
build/
coverage/
.vercel/

# Analytics runtime (durable local data — never commit)
.wyz-analytics-work/
services/analytics/.wyz-analytics-work/
**/.wyz-analytics-work/

# Observability JSONL (if enabled)
**/.wyz-observability/
.wyz-observability/

# Benchmark / eval outputs
.benchmark-results/
services/analytics/.benchmark-results/
**/.benchmark-results/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Env / secrets
.env
.env.local
.env.*.local
services/analytics/.env.local-pilot
services/analytics/.env.pilot
services/analytics/.env.docker

# Local pilot backups / smoke / regression artifacts (host-visible)
backups/
services/analytics/.p6l-smoke-*.json
services/analytics/.p6l2-regression-report.json
services/analytics/.p3-acceptance-ids.json
services/analytics/.p2-acceptance-ids.json

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
