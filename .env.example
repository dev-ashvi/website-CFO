# --- Local UI without any API (mock login + mock chat)
# VITE_DEV_DEMO_MODE=true
#
# Live demo login (always works in production builds, no env flag needed):
#   Tenant: demo
#   Email: demo@wyz.com
#   Password: demo123


# --- Real API: origin ONLY (do not add /api/v1 — paths already include it)
# VITE_API_BASE_URL=http://localhost:3001

# When unset in development, CFO chat uses an in-memory mock.
# VITE_USE_CHAT_MOCK=true

# Mock login only (chat still follows VITE_USE_CHAT_MOCK / empty base rules)
# VITE_USE_AUTH_MOCK=true

# Optional: OpenAI key for runway simulator AI insight on Vercel (fallback works without it)
# OPENAI_API_KEY=
# WYZ_INSIGHT_MODEL=gpt-4o-mini

# --- Marketplace Intelligence Ask WYZ (public /api/marketplace-ask on Vercel)
# Reuses NVIDIA NIM defaults from Revenue & Margin AI CFO. Never put these in VITE_*.
# WYZ_AI_CFO_API_KEY=
# NVIDIA_API_KEY=
# WYZ_AI_CFO_BASE_URL=https://integrate.api.nvidia.com/v1
# WYZ_AI_CFO_MODEL=openai/gpt-oss-20b
# WYZ_MARKETPLACE_ASK_MODEL=openai/gpt-oss-20b
# Shared rate limits (recommended before public launch):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# WYZ_MARKETPLACE_ASK_ALLOWED_ORIGINS=https://financewyz.ai,https://www.financewyz.ai
# WYZ_MARKETPLACE_ASK_IP_MINUTE_MAX=8
# WYZ_MARKETPLACE_ASK_IP_DAY_MAX=40
# WYZ_MARKETPLACE_ASK_GLOBAL_DAY_MAX=2000

# Optional: proxy /api during npm run dev (use VITE_USE_CHAT_MOCK=false)
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
