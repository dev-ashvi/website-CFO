# WYZ Analytics worker configuration (placeholders only — do not commit secrets)

# --- Local all-in-one dev (npm run analytics:worker) ---
WYZ_ANALYTICS_MODE=local
WYZ_ANALYTICS_WORK_DIR=./.wyz-analytics-work
WYZ_ANALYTICS_WORKER_ID=local-worker
WYZ_ANALYTICS_EMBEDDED_WORKER=true
# Observability (production pilot)
WYZ_LOG_LEVEL=INFO
WYZ_LOG_FORMAT=json
WYZ_OBSERVABILITY_ENABLED=true
# Optional rotating JSONL sink (outside durable financial blobs preferred)
# WYZ_OBSERVABILITY_FILE_ENABLED=true
# WYZ_OBSERVABILITY_FILE_PATH=./.wyz-observability/events.jsonl
# WYZ_OBSERVABILITY_MAX_BYTES=5000000
# WYZ_OBSERVABILITY_BACKUP_COUNT=3

# Machine token shared by API process and remote/Kubernetes workers.
# Generate a long random string; never commit the real value.
# WYZ_ANALYTICS_WORKER_TOKEN=

# --- Deployment mode (P3) ---
# WYZ_ENV=development|pilot|production
# Default development: no pilot token required; localhost CORS origins.
# WYZ_ENV=development
# WYZ_WORKSPACE_ID=local
# WYZ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Pilot (Docker): see .env.pilot.example — requires WYZ_PILOT_API_TOKEN + origins.
# WYZ_PILOT_API_TOKEN=  # NEVER use VITE_* for this; Vite proxy injects X-WYZ-Pilot-Token
# WYZ_MAX_UPLOAD_MB=100
# WYZ_MAX_REQUEST_BODY_MB=120

# --- Local HTTP adapter (SPA + worker API during development) ---
WYZ_ANALYTICS_HOST=127.0.0.1
WYZ_ANALYTICS_PORT=8788
# Inside Docker the process binds 0.0.0.0; Compose publishes 127.0.0.1:8788 on the host.
# See docs/docker-analytics.md, docs/security-pilot.md, .env.docker.example

# --- WYZ AI CFO (OpenAI-compatible; NVIDIA NIM by default for live eval) ---
# Standard tests use the fake model — leave provider unset or set to fake.
# WYZ_AI_CFO_PROVIDER=fake
# Live / manual:
# WYZ_AI_CFO_PROVIDER=openai_compatible
# WYZ_AI_CFO_BASE_URL=https://integrate.api.nvidia.com/v1
# WYZ_AI_CFO_MODEL=openai/gpt-oss-20b
# WYZ_AI_CFO_API_KEY=
# (NVIDIA_API_KEY is also accepted as a fallback key name.)
# WYZ_AI_CFO_HTTP_TIMEOUT_SEC=90
# WYZ_AI_CFO_HTTP_RETRIES=2
# WYZ_AI_CFO_QUESTION_TIMEOUT_SEC=300

# --- Remote / Kubernetes polling worker ---
# WYZ_ANALYTICS_MODE=remote
# WYZ_ANALYTICS_API_BASE_URL=http://host.docker.internal:8788/api/v1/analytics
# WYZ_ANALYTICS_BLOB_BACKEND=remote
# WYZ_ANALYTICS_POLL_INTERVAL_SEC=2
# WYZ_ANALYTICS_CLAIM_LEASE_SEC=300

# --- API-only mode for Kubernetes testing (disable embedded claim loop) ---
# WYZ_ANALYTICS_EMBEDDED_WORKER=false
