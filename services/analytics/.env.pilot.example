# Oracle / production pilot — PLACEHOLDERS ONLY.
# On the VM: copy to /opt/wyz/.env.pilot && chmod 600
# NEVER commit real secrets. NEVER put WYZ_PILOT_API_TOKEN in VITE_*.

WYZ_ENV=pilot
WYZ_ANALYTICS_WORK_DIR=/data/wyz-analytics-work
WYZ_HOST_WORK_DIR=/data/wyz-analytics-work
WYZ_WORKSPACE_ID=internal-pilot

# Public hostname for Caddy TLS (A/AAAA → VM public IP)
WYZ_PILOT_DOMAIN=pilot.example.com
WYZ_ACME_EMAIL=ops@example.com

# Exact browser origins (typically https://WYZ_PILOT_DOMAIN when SPA is served by Caddy)
WYZ_ALLOWED_ORIGINS=https://pilot.example.com

# Server-only shared secret (BFF → analytics). Never in browser.
WYZ_PILOT_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_PILOT_TOKEN

WYZ_BFF_REQUIRE_BEARER=true
WYZ_BFF_REJECT_DEMO=true

WYZ_AI_CFO_PROVIDER=openai_compatible
WYZ_AI_CFO_MODEL=openai/gpt-oss-20b
WYZ_AI_CFO_STRATEGY_MODE=v2_partner
WYZ_AI_CFO_STRATEGIC_MAX_TOKENS=1200
WYZ_AI_CFO_API_KEY=<secret>
# Fallback if WYZ_AI_CFO_API_KEY unset:
# NVIDIA_API_KEY=<secret>

WYZ_LOG_LEVEL=INFO
WYZ_LOG_FORMAT=json
WYZ_OBSERVABILITY_ENABLED=true

WYZ_MAX_UPLOAD_MB=100
WYZ_MAX_REQUEST_BODY_MB=120
WYZ_MAX_UPLOAD_FILES=12
WYZ_PROXY_MAX_BODY=120MB

# Optional resource hints
# WYZ_API_MEM_LIMIT=4g
# WYZ_WORKER_MEM_LIMIT=4g

# Set by deploy-pilot.sh from git when omitted
# WYZ_RELEASE_SHA=

# Built SPA directory mounted into Caddy
WYZ_FRONTEND_DIST=/opt/wyz/frontend-dist

# Provider key precedence: WYZ_AI_CFO_API_KEY → NVIDIA_API_KEY → OPENAI_API_KEY
