# Local CFO pilot — PLACEHOLDERS ONLY. Copy to .env.local-pilot (never commit secrets).
# chmod equivalent on Windows: restrict NTFS ACL to your user.

WYZ_ENV=pilot
WYZ_WORKSPACE_ID=internal-pilot
WYZ_RELEASE_SHA=local-pilot

# Exact browser origins (comma-separated). Never use *.
# Local regression + Vercel CFO frontend (www redirects to apex — omit www).
WYZ_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://financewyz.ai

# Server-only shared secret BFF → analytics (never in browser / VITE_*).
WYZ_PILOT_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_PILOT_TOKEN

# Temporary pilot login (BFF). Format: email:password,email2:password2
# Do NOT use wyz-demo credentials. Do NOT commit real values.
WYZ_PILOT_USERS=you@example.com:CHANGE_ME_PASSWORD,cfo@example.com:CHANGE_ME_PASSWORD
WYZ_PILOT_SESSION_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

WYZ_BFF_REQUIRE_BEARER=true
WYZ_BFF_REJECT_DEMO=true

# AI CFO — existing architecture (NVIDIA / OpenAI-compatible GPT-OSS)
WYZ_AI_CFO_PROVIDER=openai_compatible
WYZ_AI_CFO_MODEL=openai/gpt-oss-20b
WYZ_AI_CFO_STRATEGY_MODE=v2_partner
WYZ_AI_CFO_STRATEGIC_MAX_TOKENS=1200
WYZ_AI_CFO_API_KEY=
# NVIDIA_API_KEY=

WYZ_LOG_LEVEL=INFO
WYZ_LOG_FORMAT=json
WYZ_OBSERVABILITY_ENABLED=true

WYZ_MAX_UPLOAD_MB=100
WYZ_MAX_REQUEST_BODY_MB=120
WYZ_PROXY_MAX_BODY=120MB

# Optional local frontend-dist mount (Caddy local-pilot is API-only; SPA is Vercel).
WYZ_FRONTEND_DIST=./frontend-dist
