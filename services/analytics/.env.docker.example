# Docker / local Compose placeholders — copy to .env.docker (never commit secrets).
# For pilot hardening defaults see .env.pilot.example

WYZ_ENV=pilot
WYZ_WORKSPACE_ID=internal-pilot
WYZ_ANALYTICS_PUBLISH_BIND=127.0.0.1
WYZ_ANALYTICS_PUBLISH_PORT=8788

# Exact browser origins (comma-separated). Required in pilot/production.
WYZ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret between Vite proxy (or future BFF) and analytics API.
# NEVER put this in VITE_* / browser bundles. Generate a long random string.
WYZ_PILOT_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_PILOT_TOKEN

WYZ_MAX_UPLOAD_MB=100
WYZ_MAX_REQUEST_BODY_MB=120
WYZ_MAX_UPLOAD_FILES=12

WYZ_LOG_LEVEL=INFO
WYZ_LOG_FORMAT=json
WYZ_OBSERVABILITY_ENABLED=true

WYZ_AI_CFO_PROVIDER=fake
# WYZ_AI_CFO_PROVIDER=openai_compatible
# WYZ_AI_CFO_MODEL=openai/gpt-oss-20b
# WYZ_AI_CFO_API_KEY=
# NVIDIA_API_KEY=
# WYZ_AI_CFO_STRATEGY_MODE=v2_partner
# WYZ_AI_CFO_STRATEGIC_MAX_TOKENS=1200

# Optional remote worker machine token (not the pilot SPA token)
# WYZ_ANALYTICS_WORKER_TOKEN=

WYZ_ANALYTICS_POLL_INTERVAL_SEC=2
