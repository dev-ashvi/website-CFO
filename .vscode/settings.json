    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.wyz-analytics-work": true,
    "**/services/analytics/.wyz-analytics-work": true,
    "**/.benchmark-results": true,
    "**/services/analytics/.benchmark-results": true,
